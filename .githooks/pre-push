#!/bin/sh
# Block pushes whose dist/ was not rebuilt from src/ (or was edited by hand).
# Install once per clone: npm run hooks:install
zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
need_verify=0
not_head=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # deleting a remote branch
  touched=0
  if [ "$remote_sha" = "$zero" ]; then             # new branch / tag on the remote
    if git rev-parse --verify -q origin/main >/dev/null; then
      range="origin/main..$local_sha"
    else
      touched=1
    fi
  else
    range="$remote_sha..$local_sha"
  fi
  if [ "$touched" = 0 ] && git diff --name-only "$range" 2>/dev/null | grep -Eq '^(src/|dist/|scripts/|package(-lock)?\.json)'; then
    touched=1
  fi
  [ "$touched" = 1 ] || continue
  need_verify=1
  # verify builds the working tree, so it only proves something about the checked-out commit
  [ "$(git rev-parse "$local_sha^{commit}")" = "$head" ] || not_head=1
done

if [ "$not_head" = 1 ]; then
  echo "pre-push: ref đang push (có đổi src/ hoặc dist/) không phải commit đang checkout (HEAD)."
  echo "          Checkout ref đó rồi push lại để dist/ được kiểm tra đúng commit."
  exit 1
fi

if [ "$need_verify" = 1 ]; then
  echo "pre-push: kiểm tra dist/ khớp src/ (npm run verify)..."
  npm run verify || exit 1
fi
exit 0
