#!/bin/sh
# Block pushes whose dist/ was not rebuilt from src/ (or was edited by hand).
# Install once per clone: npm run hooks:install
zero=0000000000000000000000000000000000000000
need_verify=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue          # deleting a remote branch
  if [ "$remote_sha" = "$zero" ]; then             # new branch / tag on the remote
    if git rev-parse --verify -q origin/main >/dev/null; then
      range="origin/main..$local_sha"
    else
      need_verify=1; continue
    fi
  else
    range="$remote_sha..$local_sha"
  fi
  if git diff --name-only "$range" 2>/dev/null | grep -Eq '^(src/|dist/|package(-lock)?\.json)'; then
    need_verify=1
  fi
done

if [ "$need_verify" = 1 ]; then
  echo "pre-push: kiểm tra dist/ khớp src/ (npm run verify)..."
  npm run verify || exit 1
fi
exit 0
